# Copy to .env and fill in real values. Never commit the real .env file.

# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/political_site

# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=4000

# Comma-separated list of origins the frontend is served from, e.g.
# https://your-domain.com,https://vyuha150.github.io
CORS_ORIGIN=http://localhost:8080

# Directory where uploaded files are stored on disk.
UPLOAD_DIR=uploads

NODE_ENV=development
